rules_version = '2';
// Reglas de seguridad de Firestore para la app del entrenador.
// Se pegan en Firebase → Firestore Database → Reglas. Pon en la lista los Gmail con los que entra el entrenador.
service cloud.firestore {
  match /databases/{database}/documents {
    function esEntrenador() {
      return request.auth != null
        && request.auth.token.email in ["CORREO_1@gmail.com", "CORREO_2@gmail.com"]
        && request.auth.token.email_verified == true;
    }
    // Fichas, semanas y archivos: solo el entrenador, y solo lo suyo
    match /entrenadores/{uid}/{resto=**} {
      allow read, write: if esEntrenador() && request.auth.uid == uid;
    }
    // Lo que ve cada deportista con su enlace: se lee si se conoce el enlace, nadie puede listar
    // los demás, y solo el entrenador que lo creó puede cambiarlo
    match /publico/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if esEntrenador() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if esEntrenador() && resource.data.owner == request.auth.uid;
      // Buzón del deportista: entrenos hechos, valoraciones y carreras propuestas.
      // Solo existe si existe su enlace; las fotos no pueden pasar de ~900 KB.
      match /aportes/{id} {
        allow read, delete: if exists(/databases/$(database)/documents/publico/$(token));
        allow create, update: if exists(/databases/$(database)/documents/publico/$(token))
          && request.resource.data.tipo in ["sesion", "semana", "carrera"]
          && (!("img" in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() < 900000));
      }
    }
  }
}
