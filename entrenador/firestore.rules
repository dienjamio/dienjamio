rules_version = '2';
// Reglas de seguridad de Firestore para la app del entrenador.
// Se pegan en Firebase → Firestore Database → Reglas. Cambia TU_CORREO por el Gmail del entrenador.
service cloud.firestore {
  match /databases/{database}/documents {
    function esEntrenador() {
      return request.auth != null
        && request.auth.token.email == "TU_CORREO@gmail.com"
        && request.auth.token.email_verified == true;
    }
    // Fichas, semanas y archivos: solo el entrenador, y solo lo suyo
    match /entrenadores/{uid}/{resto=**} {
      allow read, write: if esEntrenador() && request.auth.uid == uid;
    }
    // Lo que ve cada deportista con su enlace: cualquiera con el enlace puede leer ese documento,
    // nadie puede listar los demás, y solo el entrenador que lo creó puede cambiarlo
    match /publico/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if esEntrenador() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if esEntrenador() && resource.data.owner == request.auth.uid;
    }
  }
}
